# Port the API listens on
PORT=5001

# Secret used to sign JWTs. REQUIRED when NODE_ENV=production (server refuses to start without it).
# In development a hardcoded fallback is used if unset.
JWT_SECRET=change-me-to-a-long-random-string

# Allowed CORS origin for the web app (default: *)
CORS_ORIGIN=http://localhost:5173

# One-tap demo login (POST /api/auth/demo-login). Set to 'false' to disable (returns 404).
# Default: enabled unless NODE_ENV=production.
ENABLE_DEMO_LOGIN=true

# development | test | production (test disables request logging; production hides 500 error details)
NODE_ENV=development
